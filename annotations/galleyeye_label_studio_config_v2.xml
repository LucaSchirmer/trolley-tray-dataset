<View>

  <Style>
    .container       { display: flex; gap: 16px; margin-bottom: 16px; }
    .image-panel     { flex: 1; text-align: center; }
    .image-label     { font-weight: bold; font-size: 14px;
                       margin-bottom: 6px; color: #1F3864;
                       background: #d6e4f0; padding: 4px 8px;
                       border-radius: 4px; display: inline-block; }
    .section         { background: #f2f7fb; border-radius: 8px;
                       padding: 12px 16px; margin-bottom: 12px; }
    .section-title   { font-weight: bold; font-size: 13px;
                       color: #1F3864; margin-bottom: 8px;
                       text-transform: uppercase; letter-spacing: 0.5px;
                       border-bottom: 2px solid #1F3864;
                       padding-bottom: 4px; }
    .hint            { font-size: 11px; color: #777;
                       margin-top: 2px; margin-bottom: 6px;
                       font-style: italic; }
    .pct-row         { margin-bottom: 8px; padding: 8px; background: #ffffff; border-radius: 4px; border-left: 4px solid #1F3864; }
  </Style>

  <View className="container">
    <View className="image-panel">
      <View className="image-label">◀ UNCONSUMED — Reference</View>
      <Image name="img_unconsumed" value="$unconsumed"
             zoom="true" zoomControl="true" crosshair="true"/>
    </View>

    <View className="image-panel">
      <View className="image-label">CONSUMED — Annotate Here ▶</View>
      <Image name="img_consumed" value="$consumed"
             zoom="true" zoomControl="true" crosshair="true"/>
    </View>
  </View>

  <View className="section">
    <View className="section-title">Step 1 — Draw Masks on CONSUMED image (right)</View>
    <View className="hint">
      Select a label and draw your polygon. The corresponding consumption inputs will unlock automatically below.
    </View>

    <PolygonLabels name="masks_consumed" toName="img_consumed"
                   strokeWidth="2" pointSize="small" opacity="0.4">
      <Label value="rice" background="#4A90D9"/>
      <Label value="chicken" background="#E8A838"/>
      <Label value="fish_salmon" background="#F4A460"/>
      <Label value="broccoli" background="#5CB85C"/>
      <Label value="carrots" background="#FF7F00"/>
      <Label value="salad_main" background="#8BC34A"/>
      <Label value="wrap_half_1" background="#AB47BC"/>
      <Label value="wrap_half_2" background="#CE93D8"/>
      <Label value="pasta_pesto" background="#26A69A"/>

      <Label value="bread_roll" background="#A1887F"/>
      <Label value="side_salad" background="#AED581"/>
      <Label value="brownie" background="#6D4C41"/>
      <Label value="vanilla_pudding_with_fruits" background="#FFF176"/>
      <Label value="fruit_salad" background="#EF9A9A"/>

      <Label value="water_bottle" background="#81D4FA"/>
      <Label value="coffee_cup" background="#4E342E"/>
      <Label value="tea_cup" background="#A5D6A7"/>
      <Label value="orange_juice_bottle" background="#FFB300"/>
      <Label value="cola_can" background="#C62828"/>

      <Label value="honey" background="#FFD54F"/>
      <Label value="plum_jam" background="#9C27B0"/>
      <Label value="cherry_jam" background="#D32F2F"/>
      <Label value="butter" background="#FFEB3B"/>
      <Label value="cookie" background="#FF9800"/>
    </PolygonLabels>
  </View>

  <View className="section">
    <View className="section-title">Step 2 — Consumption Assessment</View>
    <View className="hint">
      Only sections relevant to the items labeled in Step 1 will display here.
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" 
          whenChoiceValue="rice,chicken,fish_salmon,broccoli,carrots,salad_main,wrap_half_1,wrap_half_2,pasta_pesto" 
          matchAny="true">
      <View className="pct-row" style="background: #eef5fc; border-left-color: #4A90D9;">
        <Header value="Main Course — Combined Total Consumption %"/>
        <View className="hint">Enter the total percentage consumed across all parts of the main meal components.</View>
        <Number name="pct_main_course_merged" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>


    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="bread_roll">
      <View className="pct-row">
        <Header value="Bread Roll Consumption %"/>
        <Number name="pct_bread_roll" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="side_salad">
      <View className="pct-row">
        <Header value="Side Salad Consumption %"/>
        <Number name="pct_side_salad" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="fruit_salad">
      <View className="pct-row">
        <Header value="Fruit Salad Consumption %"/>
        <Number name="pct_fruit_salad" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="brownie">
      <View className="pct-row">
        <Header value="Brownie Consumption %"/>
        <Number name="pct_brownie" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="vanilla_pudding_with_fruits">
      <View className="pct-row">
        <Header value="Vanilla Pudding with Fruits Consumption %"/>
        <Number name="pct_vanilla_pudding" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>


    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="cookie">
      <View className="pct-row">
        <Header value="Cookie Consumption %"/>
        <Number name="pct_cookie" toName="img_consumed" min="0" max="100" placeholder="0-100"/>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="butter">
      <View className="pct-row">
        <Header value="Butter Status"/>
        <Choices name="extra_butter" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="honey">
      <View className="pct-row">
        <Header value="Honey Status"/>
        <Choices name="extra_honey" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="plum_jam">
      <View className="pct-row">
        <Header value="Plum Jam Status"/>
        <Choices name="extra_plum_jam" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="cherry_jam">
      <View className="pct-row">
        <Header value="Cherry Jam Status"/>
        <Choices name="extra_cherry_jam" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>


    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="water_bottle">
      <View className="pct-row">
        <Header value="Water Status"/>
        <Choices name="drink_water" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="coffee_cup">
      <View className="pct-row">
        <Header value="Coffee Status"/>
        <Choices name="drink_coffee" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="tea_cup">
      <View className="pct-row">
        <Header value="Tea Status"/>
        <Choices name="drink_tea" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="orange_juice_bottle">
      <View className="pct-row">
        <Header value="Orange Juice Status"/>
        <Choices name="drink_oj" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

    <View visibleWhen="match" whenTagName="masks_consumed" whenChoiceValue="cola_can">
      <View className="pct-row">
        <Header value="Cola Status"/>
        <Choices name="drink_cola" toName="img_consumed" choice="single" showInLine="true">
          <Choice value="Not consumed"/>
          <Choice value="Consumed"/>
        </Choices>
      </View>
    </View>

  </View>

  <View className="section">
    <View className="section-title">Step 3 — Image Quality Flags</View>
    <View className="hint">
      Always select at least "No issues" if the image pair is clean.
    </View>

    <Choices name="quality_flags" toName="img_consumed" choice="multiple" showInLine="false">
      <Choice value="No issues — image pair is clean"/>
      <Choice value="Blurry"/>
      <Choice value="Shadow on tray"/>
      <Choice value="Tray partially out of frame"/>
      <Choice value="Obstacle obscuring food (cutlery, napkin, foil)"/>
      <Choice value="Odd tray angle"/>
      <Choice value="Lighting inconsistency vs other images"/>
      <Choice value="Food rearranged significantly"/>
      <Choice value="Non-edible residuals present (bones, core, crumbs only)"/>
    </Choices>
  </View>

  <View className="section">
    <View className="section-title">Step 4 — Annotator Notes (optional)</View>
    <TextArea name="notes" toName="img_consumed"
              placeholder="Edge cases, ambiguities, visual overrides from weight data..."
              rows="2" maxSubmissions="1"/>
  </View>

</View>